# ==============================================================================
# Configuration Samba Active Directory Domain Controller (AD DC) LyuX
# Opération Manchot - Écosystème Libre Lycée
# Emplacement cible : projects/lyux-server-infra/configs/samba/smb.conf.ad-dc
# Sur le serveur : /etc/samba/smb.conf
# ==============================================================================

[global]
    netbios name = SERVEUR-LYUX
    workgroup = LYUX
    realm = LYUX.LAN
    server role = active directory domain controller

    # --- Backend Active Directory & Extensions POSIX (RFC 2307) ---
    idmap_ldb:use rfc2307 = yes
    dns forwarder = 1.1.1.1 8.8.8.8
    allow dns updates = nonsecure and secure
    nsupdate command = /usr/bin/nsupdate -g

    # --- Sécurité & Authentification ---
    security = ADS
    passdb backend = samba_dsdb
    server min protocol = SMB2_10
    client min protocol = SMB2_10
    ntlm auth = yes

    # --- Encodage de caractères & Performances ---
    unix charset = UTF-8
    dos charset = CP850
    dns proxy = no
    socket options = TCP_NODELAY IPTOS_LOWDELAY SO_RCVBUF=131072 SO_SNDBUF=131072

    # --- Journalisation & Résilience ---
    log file = /var/log/samba/log.%m
    max log size = 1000
    logging = file
    panic action = /usr/share/samba/panic-action %d

    # --- Désactivation de l'impression (non requise sur le DC) ---
    load printers = no
    printing = bsd
    printcap name = /dev/null

    # --- Prise en charge des ACLs POSIX et Quotas disques (Features 8 & 9) ---
    vfs objects = acl_xattr
    map acl inherit = yes
    inherit acls = yes
    quotas = yes

# ==============================================================================
# PARTAGES SYSTÈME ACTIVE DIRECTORY OBLIGATOIRES
# ==============================================================================

[netlogon]
    comment = Scripts d'ouverture de session Active Directory
    path = /var/lib/samba/sysvol/lyux.lan/scripts
    read only = No

[sysvol]
    comment = Répertoire SYSVOL Active Directory (GPO & Stratégies de domaine)
    path = /var/lib/samba/sysvol
    read only = No

# ==============================================================================
# PARTAGES PÉDAGOGIQUES & ESPACES PERSONNELS (Opération Manchot)
# ==============================================================================

# Dossier personnel de chaque utilisateur (monté dynamiquement sous ~/Espace_Personnel)
[homes]
    comment = Dossier Personnel LyuX
    path = /srv/samba/homes/%S
    browseable = no
    read only = no
    create mask = 0700
    directory mask = 0700
    valid users = %S
    root preexec = /usr/local/bin/lyux-create-user-home.sh %U %G

# Espaces partagés de classes (Distribution en L/S prof & RO élève ; Dépôt en L/S prof & WO élève)
[classes]
    comment = Espaces Partagés de Classes
    path = /srv/samba/classes
    browseable = yes
    read only = no
    create mask = 0770
    directory mask = 0770
    inherit acls = yes
    # Les droits fins de distribution / dépôt sont gérés par ACLs POSIX (setup-shares.sh)

# Espace d'échange réservé aux enseignants
[profs]
    comment = Espace d'échange Enseignants
    path = /srv/samba/profs
    browseable = yes
    read only = no
    create mask = 0770
    directory mask = 0770
    valid users = @enseignants, @techniciens
    force group = enseignants

# Espace d'échange Vie Scolaire / Administration
[administration]
    comment = Espace Administration et Vie Scolaire
    path = /srv/samba/administration
    browseable = no
    read only = no
    create mask = 0770
    directory mask = 0770
    valid users = @administration, @viesco, @techniciens
    force group = administration

# Dépôt public d'établissement (lecture seule pour tous, invité autorisé)
[commun]
    comment = Espace Public en Lecture Seule
    path = /srv/samba/commun
    browseable = yes
    read only = yes
    guest ok = yes
